PORT=3100
MONGODB_URI=mongodb://127.0.0.1:27017/remedygcc
ROOT_DOMAIN=remedygcc.com
NEXT_PUBLIC_ROOT_DOMAIN=remedygcc.com

# Super admin asset origin — required for tenant branding assets (logos, backgrounds).
# Set to the admin app's public URL (e.g. https://admin.remedygcc.com).
# When configured, the tenantapp rewrites /api/tenant-assets/* and /assets/*
# to this origin so branding images are served from the admin app.
# NEXT_PUBLIC_ prefix makes it available to both client and server rewrites.
NEXT_PUBLIC_SUPER_ADMIN_ASSET_ORIGIN=

# Super admin API URL — used by the tenantapp to proxy clinic data.
# The admin app manages the clinic directory in MongoDB; the tenantapp
# proxies its /api/clinics endpoint here so all apps see the same data.
# Defaults to http://localhost:3002 for local development.
SUPER_ADMIN_API_URL=http://localhost:3002

TENANT_AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_TENANT_SLUG=
